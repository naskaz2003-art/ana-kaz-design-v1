---
// "02 · Project summary": section label + info fields (3 in a row on desktop, stacked on mobile).
import InfoField from './InfoField.astro';

interface Props { label: string; fields: { label: string; value: string }[] }
const { label, fields } = Astro.props;
---
<section class="case-summary" aria-label={label}>
  <div class="case-summary__inner">
    <p class="section-label">{label}</p>
    <dl class="case-summary__fields">
      {fields.map((f) => <InfoField label={f.label} value={f.value} />)}
    </dl>
  </div>
</section>

<style>
  .case-summary { padding-block: clamp(var(--space-48), 4.4vw, var(--space-64)); background: var(--color-bg-page); }
  .case-summary__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
    max-width: calc(var(--content-max) + 2 * var(--page-margin));
    margin-inline: auto;
    padding-inline: var(--page-margin);
  }
  .case-summary__fields { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-24); margin: 0; }
  @media (min-width: 768px) {
    .case-summary__fields { grid-template-columns: repeat(auto-fit, minmax(0, 1fr)); grid-auto-flow: column; }
  }
</style>
