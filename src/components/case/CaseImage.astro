---
// "Figure" + "Image placeholder" components. Shows the photo when a file name is set in the case data file,
// otherwise a grey placeholder in the same proportions. Optional caption under the image.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  slug: string;
  ratio: string;          // "16:9", "4:5", "4:3", "3:2", "1:1"
  image?: string;
  imageAlt?: string;
  caption?: string;
  sizes?: string;
  class?: string;
}
const { slug, ratio, image = '', imageAlt = '', caption = '', sizes = '100vw', class: className } = Astro.props;
const files = import.meta.glob<{ default: ImageMetadata }>('../../assets/cases/**/*.{jpg,jpeg,png,webp,avif}', { eager: true });
const img = image ? files[`../../assets/cases/${slug}/${image}`]?.default : undefined;
const [w, h] = ratio.split(':').map(Number);
---
<figure class:list={['figure', className]}>
  <div class="figure__frame" style={`aspect-ratio: ${w} / ${h}`}>
    {img ? (
      <Image src={img} alt={imageAlt} widths={[480, 800, 1200, 1600, 2400, 2880]} sizes={sizes} class="figure__image" />
    ) : (
      <div class="figure__placeholder" role="img" aria-label={imageAlt || undefined}></div>
    )}
  </div>
  {caption && <figcaption class="figure__caption">{caption}</figcaption>}
</figure>

<style>
  .figure { display: flex; flex-direction: column; gap: var(--space-12); min-width: 0; }
  .figure__frame {
    position: relative;
    width: 100%;
    border-radius: var(--radius-8);
    overflow: hidden;
    background: var(--color-bg-placeholder);
  }
  .figure__frame :global(.figure__image) { width: 100%; height: 100%; max-width: none; object-fit: cover; }
  .figure__placeholder { width: 100%; height: 100%; }
  .figure__caption { color: var(--color-text-secondary); font-size: var(--type-label); line-height: 1.5; }
</style>
