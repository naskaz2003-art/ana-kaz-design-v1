---
// Case hero ("01 · Hero"): wide image with the project title on top (desktop) / 16:9 image with the title below (mobile),
// then breadcrumb and project facts on the dark band.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from '../Icon.astro';
import InfoField from './InfoField.astro';
import { homeHref } from '../../lib/links';

interface Props {
  slug: string;
  title: string;
  hero: { image: string; imageAlt: string };
  meta: { label: string; value: string }[];
  backLabel?: string;
}
const { slug, title, hero, meta, backLabel = 'All projects' } = Astro.props;
const files = import.meta.glob<{ default: ImageMetadata }>('../../assets/cases/**/*.{jpg,jpeg,png,webp,avif}', { eager: true });
const img = hero.image ? files[`../../assets/cases/${slug}/${hero.image}`]?.default : undefined;
---
<section id="top" class="case-hero on-dark" aria-labelledby="case-title">
  <div class="case-hero__media">
    {img ? (
      <Image src={img} alt={hero.imageAlt} widths={[640, 960, 1440, 1920, 2880]} sizes="100vw" loading="eager" fetchpriority="high" class="case-hero__image" />
    ) : (
      <div class="case-hero__placeholder"></div>
    )}
    <div class="case-hero__shade" aria-hidden="true"></div>
    <p class="case-hero__title case-hero__title--over" aria-hidden="true">{title}</p>
  </div>

  <div class="case-hero__content">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a class="back-link back-link--dark" href={homeHref('#work', false)}>
        <span class="back-link__row"><Icon name="arrow-left" />{backLabel}</span>
      </a>
      <span class="breadcrumb__sep" aria-hidden="true">/</span>
      <span class="breadcrumb__current" aria-current="page">{title}</span>
    </nav>

    <h1 id="case-title" class="case-hero__title case-hero__title--below">{title}</h1>

    <dl class="case-hero__meta">
      {meta.map((m) => <InfoField label={m.label} value={m.value} tone="dark" />)}
    </dl>
  </div>
</section>

<style>
  .case-hero {
    position: relative;
    background: var(--color-bg-scrim-2);
    color: var(--color-text-inverse);
  }

  /* Image: 16:9 on mobile, wide band (1440 × 642) on desktop */
  .case-hero__media { position: relative; aspect-ratio: 16 / 9; overflow: hidden; background: var(--color-bg-brand); }
  .case-hero__media :global(.case-hero__image) { width: 100%; height: 100%; max-width: none; object-fit: cover; }
  .case-hero__placeholder { width: 100%; height: 100%; background: var(--color-bg-brand); }
  .case-hero__shade { position: absolute; inset: 0; background: rgb(0 0 0 / 0.2); }

  .case-hero__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-32);
    max-width: calc(var(--content-max) + 2 * var(--page-margin));
    margin-inline: auto;
    padding: var(--space-32) var(--page-margin) var(--space-64);
  }

  /* Title: below the image on mobile (Mobile/H1, medium italic), over the image on desktop (bold italic 60) */
  .case-hero__title { margin: 0; font-style: italic; letter-spacing: -0.02em; }
  .case-hero__title--below { font-size: min(var(--type-h1), 10.1vw); font-weight: 500; line-height: 1; }
  .case-hero__title--over { display: none; }

  /* Breadcrumb + "Back link" */
  .breadcrumb { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-8); }
  .breadcrumb__sep,
  .breadcrumb__current { color: var(--color-text-inverse-muted); font-size: var(--type-body); line-height: 1.5; }
  .back-link {
    display: inline-flex;
    flex-direction: column;
    gap: var(--space-4);
    font-size: var(--type-ui);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.005em;
  }
  .back-link::after {
    content: '';
    height: 2px;
    background: var(--color-accent);
    opacity: 0;
    transition: opacity var(--dur-hover) var(--ease-out);
  }
  .back-link__row { display: inline-flex; align-items: center; gap: var(--space-8); }
  .back-link__row :global(.icon) { transition: transform var(--dur-hover) var(--ease-out); }
  @media (hover: hover) {
    .back-link:hover::after { opacity: 1; }
    .back-link:hover .back-link__row :global(.icon) { transform: translateX(-2px); }
  }

  .case-hero__meta { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-24); margin: 0; }

  @media (min-width: 768px) {
    .case-hero__media { aspect-ratio: auto; height: clamp(360px, 44.6vw, 760px); }
    .case-hero__title--over {
      display: block;
      position: absolute;
      inset: auto var(--page-margin) clamp(32px, 3.75vw, 54px);
      font-size: clamp(40px, 4.17vw, 60px);
      font-weight: 700;
      line-height: 1.2;
      text-align: center;
      text-wrap: balance;
    }
    .case-hero__title--below {
      /* The visible title sits on the image; this one stays for screen readers and search engines */
      position: absolute !important;
      width: 1px; height: 1px;
      margin: -1px; padding: 0; border: 0;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
    .case-hero__content {
      gap: var(--space-48);
      padding: var(--space-48) var(--page-margin) var(--space-96);
    }
    .breadcrumb { gap: var(--space-12); }
    .case-hero__meta { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
</style>
