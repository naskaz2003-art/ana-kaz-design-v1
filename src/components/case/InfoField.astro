---
// "Info field" component: thin top rule, italic label, value. Tone=Light on page background, Tone=Dark in the case hero.
// Use inside a <dl>.
interface Props { label: string; value: string; tone?: 'light' | 'dark' }
const { label, value, tone = 'light' } = Astro.props;
---
<div class:list={['info', `info--${tone}`]}>
  <dt class="info__label">{label}</dt>
  <dd class="info__value">{value}</dd>
</div>

<style>
  .info {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    min-width: 0;
    padding-top: var(--space-16);
    border-top: 1px solid var(--color-border-default);
  }
  .info__label {
    color: var(--color-text-secondary);
    font-size: var(--type-label);
    font-style: italic;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: 0.005em;
  }
  .info__value { margin: 0; color: var(--color-text-primary); font-size: var(--type-body); line-height: 1.5; }

  .info--dark { border-top-color: var(--color-border-inverse); }
  .info--dark .info__label { color: var(--color-text-inverse-muted); }
  .info--dark .info__value { color: var(--color-text-inverse); }
</style>
