---
// Header from the Figma "Header · Desktop" / "Header · Mobile" components.
// State "Top": no background, logo and links in the corners (over the hero).
// State "Pill": after scrolling, the bar gathers into a compact centred pill with a frosted background.
// Mobile: logo mark + menu button; the menu opens inside the pill ("State=Menu").
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import SmartLink from './SmartLink.astro';
import SocialButtons from './SocialButtons.astro';
import site from '../data/site.json';
import { linkFor, homeHref } from '../lib/links';

interface Props { onHome?: boolean }
const { onHome = true } = Astro.props;
const resume = linkFor('resume');
const work = homeHref('#work', onHome);
---
<header class="site-header" data-state="top" data-menu="closed">
  <div class="site-header__bar">
    <a class="site-header__logo" href={homeHref('#top', onHome)} aria-label={onHome ? 'AnaKaz — to the top of the page' : 'AnaKaz — home page'}>
      <Logo class="site-header__logo-full" />
      <Logo wordmark={false} class="site-header__logo-mark" />
    </a>

    <nav class="site-header__nav" aria-label="Main">
      <a class="nav-link" href={work}>{site.nav.portfolio}</a>
      <SmartLink class="nav-link" href={resume}>{site.nav.resume}</SmartLink>
    </nav>

    <div class="site-header__right">
      <a class="nav-link site-header__contacts" href="#contacts">{site.nav.contacts}</a>
      <SocialButtons tone="light" items={['telegram', 'mail']} class="site-header__socials" />
    </div>

    <button
      class="site-header__toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-menu"
      aria-label="Open menu"
    >
      <Icon name="menu" class="site-header__icon-menu" />
      <Icon name="close" class="site-header__icon-close" />
    </button>

    <div class="site-header__menu" id="site-menu" inert>
      <div class="site-header__menu-inner">
        <ul class="site-header__menu-links">
          <li><a class="t-h3" href={work}>{site.nav.portfolio}</a></li>
          <li><a class="t-h3" href="#contacts">{site.nav.contacts}</a></li>
        </ul>
        <SmartLink class="button button--primary" href={resume}>
          {site.about.resumeButton}
          <Icon name="arrow-down" />
        </SmartLink>
        <SocialButtons tone="light" />
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    --logo-wordmark: var(--color-text-inverse);
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    padding: var(--space-16) var(--page-margin);
    pointer-events: none;
  }

  .site-header__bar {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas: 'logo toggle' 'menu menu';
    align-items: center;
    max-width: var(--content-max);
    margin-inline: auto;
    padding: var(--space-4) 0;
    border-radius: var(--radius-8);
    color: var(--color-text-inverse);
    background-color: transparent;
    box-shadow: 0 8px 24px rgb(8 22 80 / 0);
    pointer-events: auto;
    transition:
      max-width var(--dur-header) var(--ease-out),
      padding var(--dur-header) var(--ease-out),
      background-color var(--dur-header) var(--ease-out),
      box-shadow var(--dur-header) var(--ease-out),
      color var(--dur-header) var(--ease-out);
  }

  /* Pill (scrolled) and open menu: frosted white bar */
  .site-header[data-state='pill'] .site-header__bar,
  .site-header[data-menu='open'] .site-header__bar {
    --logo-wordmark: #1b1c1f;
    padding: 6px 6px 6px var(--space-16);
    background-color: var(--color-bg-header);
    box-shadow: var(--shadow-header);
    color: var(--color-text-primary);
    -webkit-backdrop-filter: blur(var(--blur-header));
    backdrop-filter: blur(var(--blur-header));
  }
  .site-header[data-menu='open'] .site-header__bar { padding-bottom: var(--space-24); }

  .site-header[data-state='top'][data-menu='closed'] :focus-visible { outline-color: var(--color-text-inverse); }

  /* Logo */
  .site-header__logo { grid-area: logo; justify-self: start; display: inline-flex; border-radius: var(--radius-4); }
  .site-header__logo :global(.logo) { height: 32px; width: auto; }
  .site-header__logo :global(.logo__wordmark) { color: var(--logo-wordmark); transition: color var(--dur-header) var(--ease-out); }
  .site-header__logo :global(.site-header__logo-full) { display: none; }

  /* Desktop nav + right side are hidden on mobile */
  .site-header__nav,
  .site-header__right { display: none; }

  /* Menu toggle */
  .site-header__toggle {
    grid-area: toggle;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-4);
  }
  .site-header__toggle :global(.icon) { grid-area: 1 / 1; width: 24px; height: 24px; transition: opacity var(--dur-hover) var(--ease-out), transform var(--dur-menu) var(--ease-out); }
  .site-header__toggle :global(.site-header__icon-close) { opacity: 0; transform: rotate(-45deg); }
  .site-header[data-menu='open'] .site-header__toggle :global(.site-header__icon-menu) { opacity: 0; transform: rotate(45deg); }
  .site-header[data-menu='open'] .site-header__toggle :global(.site-header__icon-close) { opacity: 1; transform: none; }

  /* Mobile menu (opens inside the bar) */
  .site-header__menu {
    grid-area: menu;
    display: grid;
    grid-template-rows: 0fr;
    visibility: hidden;
    transition: grid-template-rows var(--dur-menu) var(--ease-out), visibility 0s linear var(--dur-menu);
  }
  .site-header[data-menu='open'] .site-header__menu {
    grid-template-rows: 1fr;
    visibility: visible;
    transition: grid-template-rows var(--dur-menu) var(--ease-out), visibility 0s;
  }
  .site-header__menu-inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-32);
    min-height: 0;
    overflow: hidden;
  }
  .site-header__menu-links { display: flex; flex-direction: column; gap: var(--space-16); margin-top: var(--space-32); }
  .site-header__menu-links a { display: inline-block; color: var(--color-text-primary); }
  @media (hover: hover) {
    .site-header__menu-links a:hover { color: var(--color-text-accent); }
  }

  /* ---------- Desktop / tablet ---------- */
  @media (min-width: 768px) {
    .site-header { padding-block: var(--space-24); }

    .site-header__bar {
      grid-template-columns: 1fr auto 1fr;
      grid-template-areas: 'logo nav right';
      height: 56px;
      padding: 0;
    }
    .site-header[data-state='pill'] .site-header__bar {
      max-width: 720px;
      padding: 0 var(--space-8) 0 var(--space-16);
    }

    .site-header__logo :global(.site-header__logo-full) { display: block; }
    .site-header__logo :global(.site-header__logo-mark),
    .site-header__toggle,
    .site-header__menu { display: none; }

    .site-header__nav { grid-area: nav; display: flex; gap: var(--space-8); }
    .site-header__right { grid-area: right; display: grid; justify-items: end; align-items: center; }
    .site-header__right > :global(*) {
      grid-area: 1 / 1;
      transition: opacity var(--dur-header) var(--ease-out), visibility 0s linear var(--dur-header);
    }

    .site-header .nav-link { color: inherit; }
    .site-header[data-state='top'] a.nav-link:hover { background: var(--color-bg-scrim-2); }
    .site-header[data-state='pill'] a.nav-link:hover { background: var(--color-bg-inverse-subtle); border-color: var(--color-border-default); }

    .site-header :global(.site-header__socials) { opacity: 0; visibility: hidden; }
    .site-header[data-state='pill'] .site-header__contacts { opacity: 0; visibility: hidden; }
    .site-header[data-state='pill'] :global(.site-header__socials) {
      opacity: 1;
      visibility: visible;
      transition: opacity var(--dur-header) var(--ease-out), visibility 0s;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  if (header) {
    const toggle = header.querySelector<HTMLButtonElement>('.site-header__toggle')!;
    const menu = header.querySelector<HTMLElement>('.site-header__menu')!;
    const desktop = window.matchMedia('(min-width: 768px)');

    // Top → Pill once the page is scrolled
    let ticking = false;
    const update = () => {
      header.dataset.state = window.scrollY > 40 ? 'pill' : 'top';
      ticking = false;
    };
    window.addEventListener('scroll', () => {
      if (!ticking) { ticking = true; requestAnimationFrame(update); }
    }, { passive: true });
    update();

    // Mobile menu
    const setMenu = (open: boolean, returnFocus = false) => {
      header.dataset.menu = open ? 'open' : 'closed';
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      menu.inert = !open;
      if (!open && returnFocus) toggle.focus();
    };
    toggle.addEventListener('click', () => setMenu(header.dataset.menu !== 'open'));
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a[href^="#"]')) setMenu(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && header.dataset.menu === 'open') setMenu(false, true);
    });
    document.addEventListener('click', (e) => {
      if (header.dataset.menu === 'open' && !header.contains(e.target as Node)) setMenu(false);
    });
    desktop.addEventListener('change', (e) => { if (e.matches) setMenu(false); });
  }
</script>
